import { parseArgs } from "node:util";

export const PROG = "{{NAME}}";
export const VERSION = "0.1.0";

export interface Output {
  write(text: string): void;
}

export function run(argv: string[], out: Output): number {
  const { values } = parseArgs({
    args: argv,
    options: {
      help: { type: "boolean", short: "h" },
      version: { type: "boolean" },
    },
    strict: true,
  });
  if (values.version) {
    out.write(`${PROG} ${VERSION}\n`);
    return 0;
  }
  if (values.help) {
    out.write(`Uso: ${PROG} [--help] [--version]\n`);
    return 0;
  }
  return 0;
}
