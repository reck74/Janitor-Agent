name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: {{ACTION_CHECKOUT}}
        with:
          persist-credentials: false
      - name: Versión de ShellCheck
        run: shellcheck --version
      - name: Lint
        run: make lint
      - name: Pruebas
        run: make test
