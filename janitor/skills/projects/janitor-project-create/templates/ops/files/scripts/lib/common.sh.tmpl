#!/usr/bin/env bash
# Funciones comunes. Se carga con: source "$(dirname "$0")/lib/common.sh"

DRY_RUN="${DRY_RUN:-1}"

log() {
  printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >&2
}

die() {
  log "ERROR: $*"
  exit 1
}

require_cmd() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "falta el comando: $cmd"
  done
}

# Ejecuta un comando, o solo lo muestra si DRY_RUN=1.
run() {
  if [[ "$DRY_RUN" == "1" ]]; then
    printf 'DRY-RUN:'
    printf ' %q' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}
