# Generated by apps/desktop-janitor/scripts/arch-package.mjs from PKGBUILD.in.
# Repackages the published Janitor AppImage as a native Arch Linux package.

pkgname=janitor-desktop-bin
_appname=janitor-desktop
_tag=@TAG@
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Janitor: agente de IA para toda tu tecnología (app de escritorio)'
arch=('x86_64')
url='https://github.com/reck74/Janitor-Agent'
license=('MIT')
provides=('janitor-desktop')
conflicts=('janitor-desktop')
depends=('alsa-lib' 'at-spi2-core' 'gtk3' 'libcups' 'libxkbcommon' 'libxcomposite'
         'libxdamage' 'libxrandr' 'mesa' 'nss' 'systemd-libs' 'hicolor-icon-theme'
         'xdg-utils' 'git' 'curl')
optdepends=('libsecret: guardar credenciales en el llavero del sistema'
            'libnotify: notificaciones de escritorio')
makedepends=('imagemagick')
options=('!strip' '!debug')
source=("${_appname}-${pkgver}.AppImage::${url}/releases/download/${_tag}/Janitor-linux-x86_64.AppImage"
        'janitor-desktop.sh'
        'Janitor.desktop'
        'LICENSE')
noextract=("${_appname}-${pkgver}.AppImage")
sha256sums=('@SHA_APPIMAGE@'
            '@SHA_LAUNCHER@'
            '@SHA_DESKTOP@'
            '@SHA_LICENSE@')

_icon_sizes=(16 24 32 48 64 128 256 512)

prepare() {
  cd "$srcdir"
  rm -rf squashfs-root
  chmod u+x "${_appname}-${pkgver}.AppImage"
  "./${_appname}-${pkgver}.AppImage" --appimage-extract >/dev/null
}

build() {
  cd "$srcdir"
  local size
  for size in "${_icon_sizes[@]}"; do
    mkdir -p "icons/${size}x${size}"
    magick squashfs-root/Janitor.png -resize "${size}x${size}" "icons/${size}x${size}/${_appname}.png"
  done
}

package() {
  cd "$srcdir"
  local appdir="$pkgdir/opt/${_appname}"

  install -d "$appdir"
  cp -a squashfs-root/. "$appdir/"
  rm -rf "$appdir/AppRun" "$appdir/Janitor.desktop" "$appdir/Janitor.png" "$appdir/.DirIcon" "$appdir/usr"
  # The AppImage's squashfs carries 0700 directories: make the tree readable by everyone.
  chmod -R u=rwX,go=rX "$appdir"
  chmod 4755 "$appdir/chrome-sandbox"

  install -Dm755 janitor-desktop.sh "$pkgdir/usr/bin/${_appname}"
  install -Dm644 Janitor.desktop "$pkgdir/usr/share/applications/Janitor.desktop"

  local size
  for size in "${_icon_sizes[@]}"; do
    install -Dm644 "icons/${size}x${size}/${_appname}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/${_appname}.png"
  done

  local licdir="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSE "$licdir/LICENSE"
  local extra
  for extra in LICENSE.electron.txt LICENSES.chromium.html; do
    if [[ -f "$appdir/$extra" ]]; then
      install -Dm644 "$appdir/$extra" "$licdir/$extra"
    fi
  done
}
